PORT=3000

# Polygon Amoy (or Privado default) Config
RPC_URL=https://rpc-amoy.polygon.technology/
CHAIN_ID=80002

# Issuer Node Config (As defined by Almighty Jitesh's contract)
ISSUER_DID=did:polygonid:polygon:amoy:2qQ68JyeXqJ2Q5k7Y7...
ISSUER_PRIVATE_KEY=your_private_key_here

# Credential Schema ID generated from Privado Node
SCHEMA_ID=15fa79...
SCHEMA_TYPE=UniversityDegreeCredential

# This repo's unified API (B + C) defaults to 3000 — keep frontend/Android on 3000.
# Utkarsh's original branch used 3001; we merged verifier into the main backend.
# PORT=3000
