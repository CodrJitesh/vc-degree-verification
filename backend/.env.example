PORT=3000
PRIVADO_ENABLED=true

# Public URL wallets can reach for callback (use ngrok/LAN IP on device)
PUBLIC_CALLBACK_BASE=http://localhost:3000

# Polygon Amoy
RPC_URL=https://rpc-amoy.polygon.technology/
CHAIN_ID=80002
STATE_CONTRACT=0x1a4cC30f2aA0377b0c3bc9848766D90cb4404124

# Verifier DID (replace with DID from Issuer Node / identity tool)
VERIFIER_DID=did:polygonid:polygon:amoy:2qCU58EJgrEsam5wZ3r49YiGvdkxZLQsX4jPPjJfcF

# Schema (hosted on GitHub after push)
SCHEMA_CONTEXT_URL=https://raw.githubusercontent.com/CodrJitesh/vc-degree-verification/main/schemas/university-degree.jsonld
SCHEMA_TYPE=UniversityDegreeCredential
SCHEMA_ID=

# Circuits (after npm run privado:circuits)
CIRCUITS_PATH=./privado/circuits
IPFS_GATEWAY=https://ipfs.io

# Issuer Node (when Docker is available)
ISSUER_DID=
ISSUER_PRIVATE_KEY=
ISSUER_NODE_URL=http://localhost:3001
